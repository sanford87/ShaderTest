#include "/Engine/Public/Platform.ush"

Texture2D InputTexture;
SamplerState InputSampler;
int ShiftAmount; // Positive = Right Shift (>>), Negative = Left Shift (<<)

// --- VERTEX SHADER ---
void BitShiftVS(
    in uint VertexID : SV_VertexID,
    out float4 OutPosition : SV_POSITION,
    out float2 OutUV : TEXCOORD0
)
{
    OutUV = float2((VertexID << 1) & 2, VertexID & 2);
    OutPosition = float4(OutUV * float2(2.0f, -2.0f) + float2(-1.0f, 1.0f), 0.0f, 1.0f);
}

// --- PIXEL SHADER ---
void BitShiftPS(
    in float4 SvPosition : SV_POSITION,
    in float2 UV : TEXCOORD0,
    out float4 OutColor : SV_Target0
)
{
    // 1. Sample the 16-bit input (0.0 to 1.0)
    float Value = InputTexture.Sample(InputSampler, UV).r;

    // 2. Calculate the divisor based on shift amount
    // Right Shift 2 bits = Divide by 2^2 (4)
    float Divisor = pow(2.0f, (float) ShiftAmount);

    // 3. Apply Shift
    // Note: If you want to LEFT shift, pass a negative integer from Blueprint
    float Result = Value / Divisor;

    OutColor = float4(Result, 0, 0, 1);
}