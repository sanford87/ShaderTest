#include "/Engine/Public/Platform.ush"

Texture2D SceneTexture;
Texture2D DistortionTexture;
SamplerState InputSampler;

// VS: Simple full-screen triangle (Reusing the technique from BasicColor)
void DistortVS(
    in uint VertexID : SV_VertexID,
    out float4 OutPosition : SV_POSITION,
    out float2 OutUV : TEXCOORD0
)
{
    OutUV = float2((VertexID << 1) & 2, VertexID & 2);
    OutPosition = float4(OutUV * float2(2.0f, -2.0f) + float2(-1.0f, 1.0f), 0.0f, 1.0f);
}

// PS: Apply the warp
void DistortPS(
    in float4 SvPosition : SV_POSITION,
    in float2 UV : TEXCOORD0,
    out float4 OutColor : SV_Target0
)
{
    // 1. Read the UV coordinates from the Distortion Map
    // The previous shader stored the absolute UVs in R and G channels
    float2 DistortedUV = DistortionTexture.Sample(InputSampler, UV).rg;

    // 2. Check for valid UVs (Optional safety)
    // If the distortion map has black borders (0,0), we might want to mask them out
    if (length(DistortedUV) <= 0.001)
    {
        OutColor = float4(0, 0, 0, 1); // Black border
        return;
    }

    // 3. Sample the Scene using the warped UVs
    OutColor = SceneTexture.Sample(InputSampler, DistortedUV);
}